# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-string

# Twilio Voice (Console > Account > Auth Token)
TWILIO_AUTH_TOKEN=

# Optional LLM rephrasing. Any OpenAI-compatible endpoint works, e.g.
#   OpenAI:  https://api.openai.com/v1                              model gpt-4o-mini
#   Groq:    https://api.groq.com/openai/v1                         model llama-3.1-8b-instant
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai model gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

DB_PATH=assistant.db
